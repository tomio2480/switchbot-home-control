# SwitchBot API Credentials
# Get your token and secret from https://support.switch-bot.com/hc/en-us/articles/12822710195351

SWITCHBOT_TOKEN=your_token_here
SWITCHBOT_SECRET=your_secret_here

# Discord webhook URL for discomfort index notifications (leave empty to disable)
# Discord: Server Settings > Integrations > Webhooks > New Webhook > Copy Webhook URL
DISCORD_WEBHOOK_URL=
